---
import { getLangFromUrl } from '../i18n/translations';
const lang = getLangFromUrl(Astro.url);
---
<section class="skills-section" data-reveal>
  <div class="container">
    <span class="eyebrow">{lang === 'en' ? 'Core stack' : 'Stack principal'}</span>
    <h2 class="section-title">{lang === 'en' ? 'Data analysis with production engineering behind it' : 'Análisis de datos con ingeniería de producción detrás'}</h2>
    <p class="section-subtitle">
      {lang === 'en'
        ? 'The tools I use to turn scattered data into decisions — and to keep the systems behind them running.'
        : 'Herramientas que uso para convertir datos dispersos en decisiones, y para sostener los sistemas que las alimentan.'}
    </p>
    
    <div class="skills-grid">
      <!-- Datos & Análisis -->
      <div class="skill-category">
        <h3>{lang === 'en' ? 'Data & Analytics' : 'Datos & Análisis'}</h3>
        <ul class="skill-list">
          <li>Python / pandas / NumPy</li>
          <li>{lang === 'en' ? 'SQL / analytical queries' : 'SQL / consultas analíticas'}</li>
          <li>{lang === 'en' ? 'Advanced Excel (pivot tables, Power Query)' : 'Excel avanzado (tablas dinámicas, Power Query)'}</li>
          <li>{lang === 'en' ? 'ETL, data cleaning and validation' : 'ETL, limpieza y validación de datos'}</li>
        </ul>
      </div>

      <!-- Visualización & Estadística -->
      <div class="skill-category">
        <h3>{lang === 'en' ? 'Visualization & Statistics' : 'Visualización & Estadística'}</h3>
        <ul class="skill-list">
          <li>Power BI / Tableau</li>
          <li>{lang === 'en' ? 'Dashboards and KPI definition' : 'Dashboards y definición de KPIs'}</li>
          <li>{lang === 'en' ? 'EDA, correlations, outliers' : 'EDA, correlaciones, valores atípicos'}</li>
          <li>{lang === 'en' ? 'scikit-learn / cross-validation' : 'scikit-learn / validación cruzada'}</li>
        </ul>
      </div>

      <!-- Backend -->
      <div class="skill-category">
        <h3>Backend & APIs</h3>
        <ul class="skill-list">
          <li>Node.js / Express / NestJS</li>
          <li>TypeScript / Javascript</li>
          <li>C# (.NET 8) / ASP.NET Core</li>
          <li>PostgreSQL / MongoDB / Redis</li>
        </ul>
      </div>

      <!-- AI / ML -->
      <div class="skill-category">
        <h3>AI & Machine Learning</h3>
        <ul class="skill-list">
          <li>{lang === 'en' ? 'LLM Inference (OpenAI, Gemini)' : 'Inferencia LLM (OpenAI, Gemini)'}</li>
          <li>{lang === 'en' ? 'RAG Orchestration (Pinecone / Chroma)' : 'Orquestación RAG (Pinecone / Chroma)'}</li>
          <li>{lang === 'en' ? 'Semantic Prompt Compression' : 'Compresión Semántica de Prompts'}</li>
          <li>LangChain / LlamaIndex / Agents</li>
        </ul>
      </div>

      <!-- Cloud / DevOps -->
      <div class="skill-category">
        <h3>Cloud & DevOps</h3>
        <ul class="skill-list">
          <li>GCP (Google Cloud Platform)</li>
          <li>{lang === 'en' ? 'Docker / Containers' : 'Docker / Contenedores'}</li>
          <li>CI/CD (GitHub Actions)</li>
          <li>Serverless Architecture</li>
        </ul>
      </div>

      <!-- Frontend & Web3 -->
      <div class="skill-category">
        <h3>Frontend & Web3</h3>
        <ul class="skill-list">
          <li>Astro / React / Next.js</li>
          <li>HTML5 / CSS3 / Vanilla JS</li>
          <li>Solidity / Smart Contracts</li>
          <li>Ethers.js / Web3 Integrations</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding: 6.5rem 2rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--ink-primary);
    margin: 0.75rem 0 1rem;
    font-weight: 700;
    line-height: 1.05;
    max-width: 720px;
  }

  .section-subtitle {
    color: var(--ink-secondary);
    margin-bottom: 3rem;
    max-width: 650px;
    line-height: 1.7;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .skill-category {
    background: rgba(8, 10, 15, 0.42);
    padding: 1.75rem;
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .skill-category:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: var(--shadow-soft);
  }

  .skill-category h3 {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 1rem;
    margin-bottom: 1.3rem;
    text-transform: none;
    letter-spacing: 0;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .skill-list li {
    font-family: var(--font-body);
    color: var(--ink-secondary);
    font-size: 0.98rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    padding-left: 1.2rem;
  }

  .skill-list li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }

  .skill-category:hover .skill-list li {
    color: var(--ink-primary);
  }

  .skill-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (max-width: 768px) {
    .skills-section {
      padding: 4rem 1.5rem;
    }
    
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .section-title {
      font-size: 2.15rem;
    }
  }
</style>
