<div class="dk3d-wrap" aria-hidden="true">
  <canvas id="dk3d"></canvas>
</div>

<script>
  const cv = document.getElementById('dk3d') as HTMLCanvasElement | null;
  if (cv) initDK3D(cv);

  function initDK3D(cv: HTMLCanvasElement) {
    const ctx = cv.getContext('2d');
    if (!ctx) return;

    const rootStyle = getComputedStyle(document.documentElement);
    const INK = rootStyle.getPropertyValue('--ink-primary').trim() || '#E8E0D4';
    const ACCENT = rootStyle.getPropertyValue('--accent').trim() || '#D4513A';
    const MINT = rootStyle.getPropertyValue('--accent-2').trim() || '#7DD3B0';

    const DOUT = [[0,0],[0,4],[1.5,4],[2.4,3.1],[2.4,0.9],[1.5,0]];
    const DIN = [[0.7,0.7],[0.7,3.3],[1.3,3.3],[1.7,2.9],[1.7,1.1],[1.3,0.7]];
    const KPOLY = [[0,0],[0,4],[0.8,4],[0.8,2.7],[1.9,4],[2.9,4],[1.55,2.0],[2.9,0],[1.9,0],[0.8,1.35],[0.8,0]];
    const S = 0.6, DOFF = -3.2, KOFF = 0.35, DEPTH = 0.34;

    function P2(p: number[], offX: number): [number, number] {
      return [(p[0] + offX) * S, -(p[1] - 2) * S];
    }

    /* ── Nube de partículas: datos dispersos que convergen en D/K ──
       Cada partícula tiene una posición hogar (sobre el contorno o el
       relleno de la letra) y un vector de dispersión fijo, calculado
       una sola vez al construir la nube. Un escalar global (converge /
       dragScatter) decide cuánto de ese vector se suma a la posición
       hogar — así toda la nube se mueve como un solo cuerpo en vez de
       partículas independientes, que se leería como ruido, no como
       "la misma nube, dispersa". */
    interface Particle {
      hx: number; hy: number; hz: number;
      vx: number; vy: number; vz: number;
      color: 0 | 1 | 2; // 0 = INK (D), 1 = ACCENT (K), 2 = MINT (borde, minoría)
    }

    const particles: Particle[] = [];
    const dChains: number[][] = [];
    const kChains: number[][] = [];

    function scatterVec(): [number, number, number] {
      const u = Math.random() * 2 - 1;
      const theta = Math.random() * Math.PI * 2;
      const r = Math.sqrt(1 - u * u);
      const mag = 1.4 + Math.random() * 1.8; // [1.4, 3.2]
      return [r * Math.cos(theta) * mag, r * Math.sin(theta) * mag, u * mag];
    }

    function pointInPolygon(x: number, y: number, poly: number[][]): boolean {
      let inside = false;
      for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
        const xi = poly[i][0], yi = poly[i][1], xj = poly[j][0], yj = poly[j][1];
        const hit = (yi > y) !== (yj > y) && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi;
        if (hit) inside = !inside;
      }
      return inside;
    }

    let mintCounter = 0;
    function pushEdgeParticle(raw: number[], offX: number, z: number, baseColor: 0 | 1, chain: number[]) {
      const [mx, my] = P2(raw, offX);
      const jx = mx + (Math.random() - 0.5) * 0.02 * S;
      const jy = my + (Math.random() - 0.5) * 0.02 * S;
      const jz = z + (Math.random() - 0.5) * 0.03;
      const [vx, vy, vz] = scatterVec();
      const isMint = (mintCounter++ % 6) === 5;
      particles.push({ hx: jx, hy: jy, hz: jz, vx, vy, vz, color: isMint ? 2 : baseColor });
      chain.push(particles.length - 1);
    }

    const Z_LAYERS_EDGE = [-DEPTH, -DEPTH * 0.6, -DEPTH * 0.2, DEPTH * 0.2, DEPTH * 0.6, DEPTH];

    function buildEdgeRing(poly: number[][], offX: number, baseColor: 0 | 1, targetChains: number[][]) {
      let perim = 0;
      const segs: number[] = [];
      for (let i = 0; i < poly.length; i++) {
        const a = poly[i], b = poly[(i + 1) % poly.length];
        const d = Math.hypot(b[0] - a[0], b[1] - a[1]);
        segs.push(d);
        perim += d;
      }
      const step = 0.15;
      const count = Math.max(4, Math.round(perim / step));
      for (const z of Z_LAYERS_EDGE) {
        const chain: number[] = [];
        for (let i = 0; i < count; i++) {
          const dist = (perim * i) / count;
          let acc = 0, si = 0;
          while (si < segs.length - 1 && acc + segs[si] < dist) { acc += segs[si]; si++; }
          const a = poly[si], b = poly[(si + 1) % poly.length];
          const t = segs[si] > 0 ? (dist - acc) / segs[si] : 0;
          const raw = [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
          pushEdgeParticle(raw, offX, z, baseColor, chain);
        }
        targetChains.push(chain);
      }
    }

    function buildFill(outer: number[][], hole: number[][] | null, offX: number, baseColor: 0 | 1) {
      let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
      for (const p of outer) {
        x0 = Math.min(x0, p[0]); y0 = Math.min(y0, p[1]);
        x1 = Math.max(x1, p[0]); y1 = Math.max(y1, p[1]);
      }
      const step = 0.22;
      for (let gx = x0; gx <= x1; gx += step) {
        for (let gy = y0; gy <= y1; gy += step) {
          const jx = gx + (Math.random() - 0.5) * 0.08;
          const jy = gy + (Math.random() - 0.5) * 0.08;
          if (!pointInPolygon(jx, jy, outer)) continue;
          if (hole && pointInPolygon(jx, jy, hole)) continue;
          const [mx, my] = P2([jx, jy], offX);
          for (let li = 0; li < 2; li++) {
            const z = (Math.random() * 2 - 1) * DEPTH;
            const [vx, vy, vz] = scatterVec();
            particles.push({ hx: mx, hy: my, hz: z, vx, vy, vz, color: baseColor });
          }
        }
      }
    }

    buildEdgeRing(DOUT, DOFF, 0, dChains);
    buildEdgeRing(DIN, DOFF, 0, dChains);
    buildEdgeRing(KPOLY, KOFF, 1, kChains);
    buildFill(DOUT, DIN, DOFF, 0);
    buildFill(KPOLY, null, KOFF, 1);

    function hexToRgb(hex: string): [number, number, number] {
      const clean = hex.replace('#', '');
      const n = clean.length === 3 ? clean.split('').map((c) => c + c).join('') : clean;
      const v = parseInt(n, 16) || 0;
      return [(v >> 16) & 255, (v >> 8) & 255, v & 255];
    }
    const ALPHA_BUCKETS = 12;
    const COLOR_TABLE: string[][] = [INK, ACCENT, MINT].map((hex) => {
      const [r, g, b] = hexToRgb(hex);
      return Array.from({ length: ALPHA_BUCKETS + 1 }, (_, i) => `rgba(${r},${g},${b},${(i / ALPHA_BUCKETS).toFixed(3)})`);
    });
    function colorFor(idx: 0 | 1 | 2, alpha: number): string {
      const bucket = Math.max(0, Math.min(ALPHA_BUCKETS, Math.round(alpha * ALPHA_BUCKETS)));
      return COLOR_TABLE[idx][bucket];
    }

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let scale = 100;
    let rot = -1.15, rotTarget = 0.35, vel = 0, tickClock = 0;
    let tiltX = 0, tiltY = 0, tgtTX = 0, tgtTY = 0;
    let converge = 0, convergeTarget = 0;
    let dragScatter = 0, dragScatterVel = 0;
    let dragging = false, hasDragged = false, lastX = 0, lastY = 0, dragX = 0, dragY = 0;
    let running = false, rafId = 0;

    function fit(): boolean {
      const r = cv.getBoundingClientRect();
      if (!r.width) return false;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      cv.width = Math.round(r.width * dpr);
      cv.height = Math.round(r.height * dpr);
      scale = cv.width * 0.155;
      return true;
    }

    /* Hot path: seno/coseno se calculan UNA vez por frame en draw(), no
       una vez por partícula — con ~2.000 partículas eso es la diferencia
       entre 4 llamadas trig/frame y ~8.000. */
    function projectFast(x: number, y: number, z: number, cy: number, sy: number, cx: number, sx: number): [number, number, number] {
      const x1 = x * cy - z * sy, z1 = x * sy + z * cy;
      const y1 = y * cx - z1 * sx, z2 = y * sx + z1 * cx;
      const k = 4.5 / (4.5 + z2);
      return [cv.width / 2 + x1 * k * scale, cv.height / 2 + y1 * k * scale, k];
    }

    // Solo para el frame estático de reduced-motion — no es hot path.
    function project(x: number, y: number, z: number, ayy: number, axx: number) {
      return projectFast(x, y, z, Math.cos(ayy), Math.sin(ayy), Math.cos(axx), Math.sin(axx));
    }

    const TAU = Math.PI * 2;

    function strokeChains(chains: number[][], projected: Array<[number, number, number]>, colorIdx: 0 | 1) {
      ctx!.strokeStyle = colorFor(colorIdx, 0.12);
      ctx!.beginPath();
      for (const chain of chains) {
        if (!chain.length) continue;
        const [sx0, sy0] = projected[chain[0]];
        ctx!.moveTo(sx0, sy0);
        for (let i = 1; i < chain.length; i++) {
          const [px, py] = projected[chain[i]];
          ctx!.lineTo(px, py);
        }
        ctx!.lineTo(sx0, sy0);
      }
      ctx!.stroke();
    }

    function draw(ayy: number, axx: number) {
      ctx!.clearRect(0, 0, cv.width, cv.height);
      const cy = Math.cos(ayy), sy = Math.sin(ayy), cx = Math.cos(axx), sx = Math.sin(axx);
      const offset = (1 - converge) + 0.22 * dragScatter;

      const projected: Array<[number, number, number]> = new Array(particles.length);
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        projected[i] = projectFast(
          p.hx + p.vx * offset,
          p.hy + p.vy * offset,
          p.hz + p.vz * offset,
          cy, sy, cx, sx
        );
      }

      ctx!.lineWidth = 0.7;
      strokeChains(dChains, projected, 0);
      strokeChains(kChains, projected, 1);

      for (let i = 0; i < particles.length; i++) {
        const [px, py, k] = projected[i];
        const r = Math.max(0.9, Math.min(3.2, 1.8 * k));
        const kn = Math.max(0, Math.min(1, (k - 0.6) / 1.2));
        const alpha = 0.3 + 0.6 * kn;
        ctx!.beginPath();
        ctx!.arc(px, py, r, 0, TAU);
        ctx!.fillStyle = colorFor(particles[i].color, alpha);
        ctx!.fill();
      }

      if (!hasDragged && !reduceMotion) {
        ctx!.fillStyle = 'rgba(232,224,212,0.4)';
        ctx!.font = `${Math.round(cv.width * 0.028)}px "JetBrains Mono", monospace`;
        ctx!.textAlign = 'center';
        ctx!.fillText('[ DRAG_TO_ROTATE ]', cv.width / 2, cv.height - cv.width * 0.04);
        ctx!.textAlign = 'left';
      }
    }

    function frame() {
      if (!running) return;
      tickClock += 16;
      if (tickClock > 6500) { tickClock = 0; rotTarget += Math.PI * 2; }
      vel += (rotTarget - rot) * 0.016;
      vel *= 0.86;
      rot += vel;
      tiltX += (tgtTX - tiltX) * 0.07;
      tiltY += (tgtTY - tiltY) * 0.07;
      converge += (convergeTarget - converge) * 0.045;
      const dragScatterTarget = dragging ? 1 : 0;
      dragScatterVel += (dragScatterTarget - dragScatter) * 0.06;
      dragScatterVel *= 0.80;
      dragScatter += dragScatterVel;
      draw(rot + tiltY + dragY, 0.16 + tiltX + dragX);
      rafId = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduceMotion) return;
      if (!fit()) return;
      convergeTarget = 1;
      running = true;
      rafId = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
    }

    if (reduceMotion) {
      converge = 1;
      if (fit()) draw(0.35, 0.16);
    } else {
      const io = new IntersectionObserver(
        (entries) => { entries[0].isIntersecting ? start() : stop(); },
        { threshold: 0.05 }
      );
      io.observe(cv);

      addEventListener('resize', () => { if (fit() && !running) draw(rot, 0.16); }, { passive: true });

      addEventListener('pointermove', (e) => {
        const r = cv.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        tgtTY = Math.max(-0.22, Math.min(0.22, ((e.clientX - cx) / innerWidth) * 0.5));
        tgtTX = Math.max(-0.16, Math.min(0.16, ((e.clientY - cy) / innerHeight) * 0.4));
        if (!dragging) return;
        dragY += (e.clientX - lastX) * 0.008;
        dragX += (e.clientY - lastY) * 0.008;
        lastX = e.clientX; lastY = e.clientY;
      }, { passive: true });

      cv.addEventListener('pointerdown', (e) => {
        dragging = true; hasDragged = true;
        lastX = e.clientX; lastY = e.clientY;
        cv.style.cursor = 'grabbing';
        cv.setPointerCapture(e.pointerId);
      });
      addEventListener('pointerup', () => {
        dragging = false;
        cv.style.cursor = 'grab';
      });
    }
  }
</script>

<style>
  .dk3d-wrap {
    display: none;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 400px;
    height: 440px;
    z-index: 2;
  }

  canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  @media (min-width: 1200px) {
    .dk3d-wrap {
      display: block;
    }
  }

  @media (min-width: 1600px) {
    .dk3d-wrap {
      width: 520px;
      height: 570px;
    }
  }
</style>
