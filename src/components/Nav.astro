---
import { getLangFromUrl, useTranslations } from '../i18n/translations';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const switchPath = lang === 'es'
  ? `/en${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`
  : Astro.url.pathname.replace(/^\/en/, '') || '/';

const { pathname } = Astro.url;
const isActive = (path: string) => {
  const localizedPath = lang === 'es' ? path : `/en${path === '/' ? '' : path}`;
  if (path === '/' && pathname === (lang === 'es' ? '/' : '/en')) return true;
  if (path !== '/' && pathname.startsWith(localizedPath)) return true;
  return false;
};
---
<nav class="nav">
  <div class="nav-container">
    <div class="logo-group">
      <a href={lang === 'es' ? '/' : '/en'} class="logo">
        <span class="logo-d">D</span><span class="logo-k">K</span>
      </a>
      <span class="handle">@daxkenyi001</span>
    </div>
    
    <div class="links">
      <a href={lang === 'es' ? '/projects' : '/en/projects'} class={`nav-link ${isActive('/projects') ? 'active' : ''}`}>{t('nav.projects')}</a>
      <a href={lang === 'es' ? '/about' : '/en/about'} class={`nav-link ${isActive('/about') ? 'active' : ''}`}>{t('nav.about')}</a>
      <a href={lang === 'es' ? '/community' : '/en/community'} class={`nav-link ${isActive('/community') ? 'active' : ''}`}>{lang === 'es' ? 'Comunidad' : 'Community'}</a>
      <a href={lang === 'es' ? '/contact' : '/en/contact'} class={`nav-link ${isActive('/contact') ? 'active' : ''}`}>{t('nav.contact')}</a>
    </div>

    <div class="status">
      <span class="status-dot">●</span>
      <span class="status-text">{lang === 'es' ? 'DISPONIBLE' : 'AVAILABLE'}</span>
    </div>

    <!-- Al hacer clic manual, guardar la elección para no ser redirigido automáticamente -->
    <a href={switchPath} class="lang-switch" aria-label="Cambiar idioma"
       onclick="sessionStorage.setItem('lang-chosen','1')">
      {lang === 'es' ? 'EN' : 'ES'}
    </a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(26, 29, 36, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.2rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    text-decoration: none;
  }

  .logo-d {
    color: var(--ink-primary);
  }

  .logo-k {
    color: var(--accent);
  }

  .handle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-secondary);
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ink-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    padding: 0.4rem 0.2rem;
    text-decoration: none;
    position: relative;
    transition: color 150ms ease;
  }

  /* Underline que crece desde la izquierda */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }

  .nav-link:hover {
    color: var(--ink-primary);
  }

  .nav-link.active {
    color: var(--accent);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--log-ok);
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .status-dot {
    animation: blink 1.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @media (max-width: 768px) {
    .nav-container {
      padding: 1rem;
      flex-direction: column;
      gap: 1rem;
    }

    .handle {
      display: none;
    }

    .links {
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .status {
      display: none;
    }
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-secondary);
    border: 1px solid var(--border-color);
    padding: 4px 10px;
    border-radius: 4px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
