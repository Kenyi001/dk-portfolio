---
const { pathname } = Astro.url;
const isActive = (path: string) => {
  if (path === '/' && pathname === '/') return true;
  if (path !== '/' && pathname.startsWith(path)) return true;
  return false;
};
---
<nav class="nav">
  <div class="nav-container">
    <div class="logo-group">
      <a href="/" class="logo">
        <span class="logo-d">D</span><span class="logo-k">K</span>
      </a>
      <span class="handle">@daxkenyi001</span>
    </div>
    
    <div class="links">
      <a href="/projects" class={`nav-link ${isActive('/projects') ? 'active' : ''}`}>Proyectos</a>
      <a href="/about" class={`nav-link ${isActive('/about') ? 'active' : ''}`}>About</a>
      <a href="/community" class={`nav-link ${isActive('/community') ? 'active' : ''}`}>Community</a>
      <a href="/contact" class={`nav-link ${isActive('/contact') ? 'active' : ''}`}>Contacto</a>
    </div>

    <div class="status">
      <span class="status-dot">●</span>
      <span class="status-text">DISPONIBLE</span>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(26, 29, 36, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.2rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    text-decoration: none;
  }

  .logo-d {
    color: var(--ink-primary);
  }

  .logo-k {
    color: var(--accent);
  }

  .handle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-secondary);
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ink-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .nav-link:hover, .nav-link.active {
    background-color: var(--accent);
    color: #FFF;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--log-ok);
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .status-dot {
    animation: blink 1.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @media (max-width: 768px) {
    .nav-container {
      padding: 1rem;
      flex-direction: column;
      gap: 1rem;
    }

    .handle {
      display: none;
    }

    .links {
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .status {
      display: none;
    }
  }
</style>
