---
import { getLangFromUrl, useTranslations } from '../i18n/translations';
import DK3D from './DK3D.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="bg-word" style="left:60%;top:8%;font-size:1.1rem" data-speed="0.12">RAG</span>
    <span class="bg-word" style="left:76%;top:66%;font-size:1.3rem" data-speed="0.18">OCR</span>
    <span class="bg-word" style="left:18%;top:80%;font-size:0.9rem" data-speed="0.22">Redis</span>
    <span class="bg-word" style="left:74%;top:28%;font-size:1rem" data-speed="0.10">C# .NET</span>
    <span class="bg-word" style="left:42%;top:88%;font-size:0.85rem" data-speed="0.28">TypeScript</span>
    <span class="bg-word" style="left:9%;top:22%;font-size:0.8rem" data-speed="0.20">Webhooks</span>
  </div>

  <DK3D />

  <div class="hero-content">
    <span class="pre-title">{t('hero.pretitle')}</span>

    <h1 class="title">
      {lang === 'en' ? (
        <>
          <span class="title-line">Building AI</span>
          <span class="title-line">backend systems</span>
          <span class="title-line">that survive</span>
          <span class="title-line">production.</span>
        </>
      ) : (
        <>
          <span class="title-line">Construyendo</span>
          <span class="title-line">backend con IA</span>
          <span class="title-line">listo para</span>
          <span class="title-line">producción.</span>
        </>
      )}
    </h1>

    <div class="badge-role">{t('hero.badge')}</div>

    <p class="bio">{t('hero.bio')}</p>

    <div class="hero-stats" aria-label="Highlights">
      <div class="stat-item">
        <span class="stat-num">2</span>
        <span class="stat-label">{t('hero.stats.prod')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">#89</span>
        <span class="stat-label">{t('hero.stats.rank')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">80%</span>
        <span class="stat-label">{lang === 'en' ? 'token cost reduction' : 'reducción de tokens'}</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">4+</span>
        <span class="stat-label">{t('hero.stats.hackathons')}</span>
      </div>
    </div>

    <div class="signal-row">
      <span>Node.js</span>
      <span>TypeScript</span>
      <span>C# .NET 8</span>
      <span>GCP / Azure / AWS</span>
    </div>

    <div class="cta-group">
      <a href={lang === 'es' ? '/contact' : '/en/contact'} class="cta-button primary">{t('hero.cta.connect')}</a>
      <a href={lang === 'es' ? '/projects' : '/en/projects'} class="cta-button secondary">{t('hero.cta.projects')}</a>
    </div>

    <div class="profile-links" aria-label="Professional links">
      <a href="mailto:daxkenyi001@gmail.com">Email</a>
      <a href="https://www.linkedin.com/in/kenyi001/?locale=es" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/Kenyi001" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/cv/CV_Dax_Kenji_AI_Backend_ES.pdf">CV</a>
    </div>
  </div>

  <div class="hero-rule" aria-hidden="true"></div>
</section>

<script>
  /* Parallax de las palabras del fondo */
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const words = document.querySelectorAll<HTMLElement>('.bg-word');
    if (!words.length) return;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        words.forEach(w => {
          const spd = parseFloat(w.dataset.speed ?? '0.2');
          w.style.transform = `translateY(${-y * spd}px)`;
        });
        ticking = false;
      });
    }, { passive: true });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 76px);
    min-height: calc(100svh - 76px);
    max-width: 1200px;
    margin: 0 auto;
    padding: 7.5rem 2rem 5.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Fondo de palabras ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .bg-word {
    position: absolute;
    font-family: var(--font-mono);
    color: var(--hash-color);
    opacity: 0.075;
    white-space: nowrap;
    font-weight: 500;
    will-change: transform;
    user-select: none;
    line-height: 1;
  }

  /* ── Contenido principal ── */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
    max-width: 710px;
  }

  .pre-title {
    font-family: var(--font-mono);
    color: var(--accent-2);
    font-size: 0.82rem;
    margin-bottom: 1.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title {
    font-family: var(--font-display);
    font-size: 4.9rem;
    line-height: 0.94;
    margin-bottom: 1.6rem;
    font-weight: 700;
    letter-spacing: 0;
    max-width: 920px;
  }

  .title-line {
    display: block;
  }

  .badge-role {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    background: rgba(236, 115, 87, 0.10);
    border: 1px solid rgba(236, 115, 87, 0.28);
    padding: 0.48rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1.7rem;
    letter-spacing: 0.02em;
    font-weight: 500;
    line-height: 1.35;
    max-width: 100%;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--ink-secondary);
    max-width: 690px;
    line-height: 1.75;
    margin-bottom: 2.2rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    gap: 0.9rem;
    margin-bottom: 1.4rem;
    width: min(100%, 760px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 104px;
    padding: 1.1rem;
    background: rgba(245, 241, 234, 0.045);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    justify-content: space-between;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    letter-spacing: 0;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.35;
  }

  .signal-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 2.4rem;
  }

  .signal-row span {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.38rem 0.7rem;
    background: rgba(8, 10, 15, 0.42);
  }

  .cta-group {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 1.4rem;
  }

  .cta-button {
    font-family: var(--font-body);
    font-size: 0.98rem;
    padding: 0.82rem 1.25rem;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .cta-button.primary {
    background-color: var(--accent);
    color: #130B08;
    border: 1px solid rgba(236, 115, 87, 0.84);
    box-shadow: 0 18px 50px rgba(236, 115, 87, 0.16);
  }
  .cta-button.primary:hover {
    transform: translateY(-2px);
  }
  .cta-button.secondary {
    background-color: rgba(245, 241, 234, 0.045);
    color: var(--ink-primary);
    border: 1px solid var(--border-mid);
  }
  .cta-button.secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .profile-links a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .profile-links a:hover {
    color: var(--accent-2);
  }

  /* ── Línea divisoria base del hero ── */
  .hero-rule {
    position: absolute;
    bottom: 3rem;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--border-strong) 24%,
      var(--border-subtle) 70%,
      transparent 100%
    );
  }

  /* ── 2K y pantallas anchas ── */
  @media (min-width: 1600px) {
    .title {
      font-size: 5.6rem;
    }
    .title-surname {
      font-size: 1.2rem;
    }
    .pre-title  { font-size: 1.15rem; }
    .bio        { font-size: 1.15rem; }
    .badge-role { font-size: 1rem; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      padding: 4.5rem 1.5rem 4rem;
      align-items: flex-start;
      width: 100%;
      max-width: 100vw;
    }
    .hero-content {
      width: 100%;
      max-width: min(calc(100vw - 3rem), 342px);
    }
    .title {
      font-size: 2.35rem;
      line-height: 0.98;
      max-width: 100%;
    }
    .badge-role {
      white-space: normal;
      width: 100%;
    }
    .bio,
    .signal-row,
    .cta-group,
    .profile-links {
      max-width: 100%;
    }
    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat-item {
      min-height: 96px;
      padding: 0.95rem;
    }
    .cta-group {
      width: 100%;
    }
    .cta-button {
      text-align: center;
      flex: 1 1 170px;
    }
    .bg-word {
      opacity: 0.025;
      font-size: 0.75rem !important;
    }
    .hero-rule {
      bottom: 1.5rem;
    }
  }

</style>
