---
import { getLangFromUrl, useTranslations } from '../i18n/translations';
import DK3D from './DK3D.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- hero-pin le da altura extra al contenedor para que el sticky tenga
     recorrido: mientras scrolleás esos 120vh el DK3D hace el explode -->
<div class="hero-pin">
  <section class="hero">
    <div class="hero-inner">
      <DK3D />

      <div class="hero-content">
        <span class="pre-title">{t('hero.pretitle')}</span>

        <h1 class="title">
          <span class="title-dax">DAX</span> <span class="title-kenji">KENJI</span>
          <span class="sr-only">Tellez Duran</span>
        </h1>

        <div class="badge-role">{t('hero.badge')}</div>

        <p class="bio">{t('hero.bio')}</p>

        <div class="location-line">Santa Cruz, Bolivia · UTC-4</div>

        <div class="cta-group">
          <a href={lang === 'es' ? '/contact' : '/en/contact'} class="cta-button primary">{t('hero.cta.connect')}</a>
          <a href={lang === 'es' ? '/projects' : '/en/projects'} class="cta-button secondary">{t('hero.cta.projects')}</a>
        </div>
      </div>
    </div>

    <!-- Indicador de scroll — sólo se ve hasta que el usuario empieza a bajar -->
    <div class="scroll-cue" aria-hidden="true">
      <span class="scroll-cue-line"></span>
    </div>
  </section>
</div>

<style>
  /* Contenedor que da recorrido al sticky */
  .hero-pin {
    height: 220vh;
  }

  /* El hero se queda fijo mientras hero-pin scrollea */
  .hero {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Centra el contenido con max-width, ocupa toda la altura */
  .hero-inner {
    position: relative;
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 7rem 2rem 4rem;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
    max-width: 52%;
  }

  .pre-title {
    font-family: var(--font-mono);
    color: var(--hash-color);
    font-size: 1rem;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    line-height: 0.95;
    margin-bottom: 2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .title-dax  { color: var(--ink-primary); }
  .title-kenji { color: var(--accent); }

  .badge-role {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    padding: 0.4rem 1rem;
    border-radius: 4px;
    margin-bottom: 2.5rem;
    letter-spacing: 0.08em;
    font-weight: bold;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--ink-secondary);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .location-line {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ink-secondary);
    margin-bottom: 3rem;
    letter-spacing: 0.03em;
  }

  .cta-group {
    display: flex;
    gap: 1.5rem;
  }

  .cta-button {
    font-family: var(--font-mono);
    font-size: 1rem;
    padding: 0.8rem 1.6rem;
    border-radius: 4px;
    font-weight: bold;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .cta-button.primary {
    background-color: var(--accent);
    color: var(--bg-primary);
    border: 1px solid var(--accent);
  }
  .cta-button.primary:hover {
    background-color: transparent;
    color: var(--accent);
  }
  .cta-button.secondary {
    background-color: transparent;
    color: var(--ink-primary);
    border: 1px solid var(--border-strong);
  }
  .cta-button.secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Scroll cue — línea animada que invita a bajar */
  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: cue-appear 0.8s 1.8s ease both;
  }

  @keyframes cue-appear {
    from { opacity: 0; transform: translateX(-50%) translateY(8px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .scroll-cue-line {
    display: block;
    width: 1px;
    height: 52px;
    background: linear-gradient(to bottom, var(--ink-secondary), transparent);
    animation: line-drop 2s ease-in-out infinite;
    transform-origin: top center;
  }

  @keyframes line-drop {
    0%   { transform: scaleY(0); opacity: 0.8; }
    60%  { transform: scaleY(1); opacity: 0.6; }
    100% { transform: scaleY(1); opacity: 0;   }
  }

  /* Ocultar scroll-cue una vez que el usuario scrolleó */
  .hero-pin.scrolled .scroll-cue { display: none; }

  /* ── MOBILE ── */
  @media (max-width: 1199px) {
    /* Sin DK3D visible: el contenido puede ocupar más ancho */
    .hero-content {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    /* En mobile no hay DK3D ni recorrido sticky — lo bajamos a 100vh simple */
    .hero-pin {
      height: auto;
    }
    .hero {
      position: relative;
      height: auto;
      min-height: 100svh;
    }
    .hero-inner {
      padding: 5rem 1.5rem 4rem;
      justify-content: flex-start;
    }
    .cta-group {
      flex-direction: column;
      width: 100%;
    }
    .cta-button {
      text-align: center;
    }
    .scroll-cue {
      display: none;
    }
  }
</style>

<script>
  /* Oculta el scroll-cue en cuanto el usuario mueve la rueda */
  (function () {
    const pin = document.querySelector('.hero-pin');
    if (!pin) return;
    const onScroll = () => {
      if (window.scrollY > 20) {
        pin.classList.add('scrolled');
        window.removeEventListener('scroll', onScroll);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
