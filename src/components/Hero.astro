---
import { getLangFromUrl, useTranslations } from '../i18n/translations';
import DK3D from './DK3D.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
  <!-- Fondo con palabras técnicas que hacen parallax al scrollear -->
  <div class="hero-bg" aria-hidden="true">
    <span class="bg-word" style="left:64%;top:6%;font-size:1.9rem"   data-speed="0.13">RAG</span>
    <span class="bg-word" style="left:72%;top:68%;font-size:2.4rem"  data-speed="0.19">LLM</span>
    <span class="bg-word" style="left:72%;top:58%;font-size:1.0rem"  data-speed="0.26">Node.js</span>
    <span class="bg-word" style="left:38%;top:88%;font-size:0.85rem" data-speed="0.32">TypeScript</span>
    <span class="bg-word" style="left:80%;top:32%;font-size:1.4rem"  data-speed="0.09">Web3</span>
    <span class="bg-word" style="left:10%;top:84%;font-size:1.0rem"  data-speed="0.23">Redis</span>
    <span class="bg-word" style="left:46%;top:8%;font-size:0.85rem"  data-speed="0.16">C# .NET</span>
    <span class="bg-word" style="left:83%;top:76%;font-size:1.1rem"  data-speed="0.21">OCR</span>
    <span class="bg-word" style="left:1%;top:44%;font-size:0.85rem"  data-speed="0.29">Cardano</span>
    <span class="bg-word" style="left:57%;top:50%;font-size:1.0rem"  data-speed="0.11">Docker</span>
    <span class="bg-word" style="left:25%;top:92%;font-size:1.2rem"  data-speed="0.37">GCP</span>
    <span class="bg-word" style="left:70%;top:18%;font-size:0.85rem" data-speed="0.17">Stellar</span>
    <span class="bg-word" style="left:50%;top:73%;font-size:0.9rem"  data-speed="0.14">Python</span>
    <span class="bg-word" style="left:88%;top:50%;font-size:0.8rem"  data-speed="0.28">Solidity</span>
    <span class="bg-word" style="left:18%;top:12%;font-size:0.95rem" data-speed="0.20">Webhooks</span>
  </div>

  <DK3D />

  <div class="hero-content">
    <span class="pre-title">{t('hero.pretitle')}</span>

    <h1 class="title">
      <span class="title-name-line">
        <span class="title-dax">DAX</span> <span class="title-kenji">KENJI</span>
      </span>
      <span class="title-surname">Tellez Duran</span>
    </h1>

    <div class="badge-role">{t('hero.badge')}</div>

    <p class="bio">{t('hero.bio')}</p>

    <div class="location-line">Santa Cruz, Bolivia · UTC-4</div>

    <div class="cta-group">
      <a href={lang === 'es' ? '/contact' : '/en/contact'} class="cta-button primary">{t('hero.cta.connect')}</a>
      <a href={lang === 'es' ? '/projects' : '/en/projects'} class="cta-button secondary">{t('hero.cta.projects')}</a>
    </div>
  </div>

  <div class="hero-rule" aria-hidden="true"></div>
</section>

<script>
  /* Parallax de las palabras del fondo */
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const words = document.querySelectorAll<HTMLElement>('.bg-word');
    if (!words.length) return;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        words.forEach(w => {
          const spd = parseFloat(w.dataset.speed ?? '0.2');
          w.style.transform = `translateY(${-y * spd}px)`;
        });
        ticking = false;
      });
    }, { passive: true });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7rem 2rem 5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Fondo de palabras ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .bg-word {
    position: absolute;
    font-family: var(--font-mono);
    color: var(--hash-color);
    opacity: 0.05;
    white-space: nowrap;
    font-weight: 500;
    will-change: transform;
    user-select: none;
    line-height: 1;
  }

  /* ── Contenido principal ── */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
    max-width: 560px;
  }

  .pre-title {
    font-family: var(--font-mono);
    color: var(--hash-color);
    font-size: 1rem;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    line-height: 0.95;
    margin-bottom: 2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .title-name-line {
    display: block;
  }

  .title-dax   { color: var(--ink-primary); }
  .title-kenji { color: var(--accent); }

  .title-surname {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.6vw, 1.1rem);
    font-weight: 400;
    color: var(--ink-secondary);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 0.75rem;
    opacity: 0.65;
  }

  .badge-role {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    padding: 0.4rem 1rem;
    border-radius: 4px;
    margin-bottom: 2.5rem;
    letter-spacing: 0.08em;
    font-weight: bold;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--ink-secondary);
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .location-line {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ink-secondary);
    margin-bottom: 3rem;
    letter-spacing: 0.03em;
  }

  .cta-group {
    display: flex;
    gap: 1.5rem;
  }

  .cta-button {
    font-family: var(--font-mono);
    font-size: 1rem;
    padding: 0.8rem 1.6rem;
    border-radius: 4px;
    font-weight: bold;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .cta-button.primary {
    background-color: var(--accent);
    color: var(--bg-primary);
    border: 1px solid var(--accent);
  }
  .cta-button.primary:hover {
    background-color: transparent;
    color: var(--accent);
  }
  .cta-button.secondary {
    background-color: transparent;
    color: var(--ink-primary);
    border: 1px solid var(--border-strong);
  }
  .cta-button.secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Línea divisoria base del hero ── */
  .hero-rule {
    position: absolute;
    bottom: 3rem;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--border-strong) 30%,
      var(--border-subtle) 70%,
      transparent 100%
    );
  }

  /* ── 2K y pantallas anchas ── */
  @media (min-width: 1600px) {
    .title {
      font-size: 8rem;
    }
    .title-surname {
      font-size: 1.2rem;
    }
    .pre-title  { font-size: 1.15rem; }
    .bio        { font-size: 1.15rem; }
    .badge-role { font-size: 1rem; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      padding: 5rem 1.5rem 4rem;
      align-items: flex-start;
    }
    .hero-content {
      max-width: 100%;
    }
    .cta-group {
      flex-direction: column;
      width: 100%;
    }
    .cta-button {
      text-align: center;
    }
    .bg-word {
      opacity: 0.025;
      font-size: 0.75rem !important;
    }
    .hero-rule {
      bottom: 1.5rem;
    }
  }
</style>
