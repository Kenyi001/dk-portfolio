---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="brand">
        <span class="logo-d">D</span><span class="logo-k">K</span>
      </div>
      
      <div class="contact-info">
        <a href="mailto:daxkenyi001@gmail.com" class="contact-link">daxkenyi001@gmail.com</a>
        <a href="tel:+59178447843" class="contact-link">+591 78447843</a>
        <a href="https://linkedin.com/in/kenyi001" target="_blank" rel="noopener noreferrer" class="contact-link">LinkedIn</a>
        <a href="https://github.com/Kenyi001" target="_blank" rel="noopener noreferrer" class="contact-link">GitHub</a>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {year} Dax Kenji Tellez Duran. All rights reserved. // build_success</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-mid);
    padding: 5rem 2rem 3rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 900;
    letter-spacing: -0.05em;
  }

  .logo-d { color: var(--ink-primary); }
  .logo-k { color: var(--accent); }

  .contact-info {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .contact-link {
    font-family: var(--font-mono);
    color: var(--ink-secondary);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .contact-link:hover {
    color: var(--accent);
  }

  .footer-bottom {
    text-align: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 2rem;
    font-family: var(--font-mono);
    color: var(--ink-secondary);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    
    .contact-info {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
