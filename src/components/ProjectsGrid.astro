---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { getLangFromUrl } from '../i18n/translations';

interface Props {
  projects?: any[];
}

const { projects: propProjects } = Astro.props;
const dbProjects = await getCollection('projects');
let projects = propProjects || dbProjects;

// Detect current language
const lang = getLangFromUrl(Astro.url);

// Filter button labels by language
const filterLabels = {
  all:          lang === 'en' ? 'All work' : 'Todo',
  ai:           lang === 'en' ? 'AI systems' : 'Sistemas IA',
  web3:         'Web3',
  profesional:  lang === 'en' ? 'Production' : 'Producción',
};

// Sort by date descending (more recent first)
projects = projects.sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<section id="projects" class="projects-section" data-reveal>
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">{lang === 'en' ? 'Selected proof' : 'Evidencia seleccionada'}</span>
        <h2 class="section-title">{lang === 'en' ? 'Production-minded AI and backend work' : 'IA y backend con mentalidad de producción'}</h2>
        <p class="section-subtitle">
          {lang === 'en'
            ? 'Curated projects with clear systems thinking: banking AI, RAG, OCR, on-chain analytics and shipped web products.'
            : 'Proyectos curados con pensamiento de sistemas: IA bancaria, RAG, OCR, analítica on-chain y productos web desplegados.'}
        </p>
      </div>
      
      <!-- Filter controls -->
      <div class="filters">
        <button class="filter-btn active" data-filter="all">{filterLabels.all}</button>
        <button class="filter-btn" data-filter="ai">{filterLabels.ai}</button>
        <button class="filter-btn" data-filter="web3">{filterLabels.web3}</button>
        <button class="filter-btn" data-filter="profesional">{filterLabels.profesional}</button>
      </div>
    </div>

    <div class="projects-grid" id="grid">
      {projects.map(project => {
        // Classify project into filters
        const slug = project.id;
        const isAi = slug === 'token-saver' || slug === 'ledgerlens' || slug === 'ai-voice-agent' || slug === 'ocr-pipeline' || slug === 'whatsapp-rag-bot';
        const isWeb3 = slug === 'trustark' || slug === 'enaid';
        const isProfesional = project.data.eventType === 'professional';
        
        const categoryClasses = [];
        if (isAi) categoryClasses.push('cat-ai');
        if (isWeb3) categoryClasses.push('cat-web3');
        if (isProfesional) categoryClasses.push('cat-profesional');
        
        const dataCategories = [];
        if (isAi) dataCategories.push('ai');
        if (isWeb3) dataCategories.push('web3');
        if (isProfesional) dataCategories.push('profesional');
        
        // Pick content based on language
        const title = lang === 'en' && project.data.title_en ? project.data.title_en : project.data.title;
        const description = lang === 'en' && project.data.description_en ? project.data.description_en : project.data.description;
        const role = lang === 'en' && project.data.role_en ? project.data.role_en : project.data.role;
        const metrics = lang === 'en' && project.data.metrics_en ? project.data.metrics_en : project.data.metrics;
        const projectSlug = lang === 'en' ? `/en/projects/${project.id}` : `/projects/${project.id}`;

        return (
          <div class={`grid-item all ${categoryClasses.join(' ')}`} data-category={dataCategories.join(',')}>
            <ProjectCard
              title={title}
              event={project.data.event}
              eventType={project.data.eventType}
              description={description}
              role={role}
              slug={projectSlug}
              stack={project.data.stack}
              award={project.data.award}
              metrics={metrics}
              repoUrl={project.data.repoUrl}
              demoUrl={project.data.demoUrl}
              lang={lang}
            />
          </div>
        );
      })}

      <!-- Current Build dashed card -->
      <div class="grid-item all cat-ai cat-web3 final-build-card" data-category="ai,web3">
        <div class="build-card-content">
          <div class="card-top">
            <span class="badge blinking">● {lang === 'en' ? 'IN PROGRESS' : 'EN CONSTRUCCIÓN'}</span>
            <span class="hash">// pending_deploy</span>
          </div>
          <h3 class="build-title">{lang === 'en' ? 'Current focus' : 'Foco actual'}</h3>
          <p class="build-desc">
            {lang === 'en'
              ? 'Designing a unified RAG platform for automatic indexing and multi-agent orchestration.'
              : 'Diseñando una plataforma RAG unificada para indexación automática y orquestación multi-agente.'}
          </p>
          <div class="build-counter">
            <span class="days-label">{lang === 'en' ? 'STATUS' : 'ESTADO'}</span>
            <span class="days-value">{lang === 'en' ? 'in progress' : 'en progreso'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Filter logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const gridItems = document.querySelectorAll('.grid-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle active state on buttons
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filterValue = btn.getAttribute('data-filter');

      gridItems.forEach(item => {
        const categoryAttr = item.getAttribute('data-category') || '';
        const categories = categoryAttr.split(',');
        const isFinalCard = item.classList.contains('final-build-card');

        // Reset item opacity/transition
        (item as HTMLElement).style.opacity = '0';
        (item as HTMLElement).style.transform = 'scale(0.95)';

        setTimeout(() => {
          if (filterValue === 'all' || categories.includes(filterValue) || isFinalCard) {
            (item as HTMLElement).style.display = 'block';
            setTimeout(() => {
              (item as HTMLElement).style.opacity = '1';
              (item as HTMLElement).style.transform = 'scale(1)';
            }, 50);
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        }, 200);
      });
    });
  });
</script>

<style>
  .projects-section {
    padding: 6.5rem 0;
    background-color: var(--bg-primary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 3.1rem;
    color: var(--ink-primary);
    font-weight: 700;
    line-height: 1.02;
    max-width: 760px;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    color: var(--ink-secondary);
    max-width: 700px;
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: rgba(245, 241, 234, 0.04);
  }

  .filter-btn {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    color: var(--ink-secondary);
    font-size: 0.78rem;
    cursor: pointer;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .filter-btn:hover, .filter-btn.active {
    color: var(--ink-primary);
    background: rgba(236, 115, 87, 0.12);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.2rem;
  }

  .grid-item {
    transition: opacity 0.2s ease, transform 0.2s ease;
    opacity: 1;
    transform: scale(1);
  }

  /* Dash build card styling */
  .final-build-card {
    border: 1px solid rgba(125, 211, 176, 0.22);
    background-color: rgba(125, 211, 176, 0.06);
    border-radius: 8px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 380px;
  }

  .build-card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-2);
    background-color: rgba(75, 138, 110, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .badge.blinking {
    animation: blink-anim 1.5s infinite;
  }

  @keyframes blink-anim {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hash {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-secondary);
  }

  .build-title {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    color: var(--ink-primary);
    margin-bottom: 1.5rem;
  }

  .build-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .build-counter {
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-secondary);
  }

  .days-label {
    color: var(--ink-secondary);
  }

  .days-value {
    color: var(--accent-2);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .filters {
      display: flex;
      overflow-x: auto;
      white-space: nowrap;
      width: 100%;
      padding-bottom: 0.5rem;
      gap: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }

    .filter-btn {
      flex-shrink: 0;
      padding: 0.4rem 0.6rem;
      font-size: 0.85rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      font-size: 2.2rem;
    }
  }
</style>
