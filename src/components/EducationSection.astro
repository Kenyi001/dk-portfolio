---
import { getLangFromUrl } from '../i18n/translations';
const lang = getLangFromUrl(Astro.url);
---
<section class="education-section">
  <div class="container">
    <h2 class="section-title">// education · academic_log</h2>

    <div class="edu-card">
      <div class="edu-header">
        <div class="edu-title-group">
          <h3 class="degree">
            {lang === 'en' ? 'Systems Engineering' : 'Ingeniería de Sistemas'}
          </h3>
          <span class="institution">
            {lang === 'en'
              ? 'UTEPSA — Private Technological University of Santa Cruz'
              : 'UTEPSA — Universidad Tecnológica Privada de Santa Cruz'}
          </span>
        </div>
        <span class="status-badge">
          {lang === 'en' ? '● ONGOING' : '● EN CURSO'}
        </span>
      </div>

      <div class="edu-meta">
        <span class="meta-item">
          <span class="meta-label">{lang === 'en' ? 'PERIOD:' : 'PERÍODO:'}</span>
          <span class="meta-val">{lang === 'en' ? 'Feb 2020 — present' : 'Feb 2020 — actualidad'}</span>
        </span>
        <span class="meta-item">
          <span class="meta-label">{lang === 'en' ? 'LOCATION:' : 'UBICACIÓN:'}</span>
          <span class="meta-val">Santa Cruz, Bolivia</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .education-section {
    padding: 4rem 2rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--hash-color);
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .edu-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--hash-color);
    padding: 2rem 2.5rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .edu-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .degree {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ink-primary);
    font-weight: 700;
  }

  .institution {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--hash-color);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--hash-color);
    background: rgba(75, 138, 110, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    white-space: nowrap;
    font-weight: bold;
    animation: blink-edu 2s infinite;
  }

  @keyframes blink-edu {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
  }

  .edu-meta {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .meta-item {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    display: flex;
    gap: 0.6rem;
  }

  .meta-label {
    color: var(--ink-secondary);
  }

  .meta-val {
    color: var(--ink-primary);
  }

  @media (max-width: 768px) {
    .education-section { padding: 3rem 1.5rem; }
    .edu-card          { padding: 1.5rem; }
    .edu-header        { flex-direction: column; }
    .edu-meta          { flex-direction: column; gap: 0.75rem; }
  }
</style>
