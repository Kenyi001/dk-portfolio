---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Convert eventType enum to print labels
const typeLabels = {
  hackathon: 'HACKATHON',
  personal: 'PERSONAL',
  professional: 'PRODUCCIÓN'
};
---

<BaseLayout title={`${entry.data.title} | Dax Kenji`} description={entry.data.description}>
  <div class="project-detail">
    <div class="container">
      <header class="project-header">
        <div class="meta-top">
          <span class="badge">{typeLabels[entry.data.eventType]}</span>
          <span class="hash">{entry.data.event}</span>
        </div>
        
        <h1 class="title">{entry.data.title}</h1>

        <div class="header-cols">
        <div class="header-intro">
        <span class="role-line">ROL → {entry.data.role}</span>

        <p class="description">{entry.data.longDescription || entry.data.description}</p>
        </div>

        <div class="meta-info">
          <div class="stack">
            {entry.data.stack.map(tech => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
          
          <div class="attributes">
            <div class="attr-item">
              <span class="attr-label">EVENTO / CONTEXTO:</span>
              <span class="attr-val">{entry.data.event}</span>
            </div>
            {entry.data.award && (
              <div class="attr-item">
                <span class="attr-label">PREMIO / RECONOCIMIENTO:</span>
                <span class="attr-val highlight">{entry.data.award}</span>
              </div>
            )}
            {entry.data.metrics && (
              <div class="attr-item">
                <span class="attr-label">MÉTRICAS / IMPACTO:</span>
                <span class="attr-val ok">{entry.data.metrics}</span>
              </div>
            )}
            {entry.data.date && (
              <div class="attr-item">
                <span class="attr-label">FECHA:</span>
                <span class="attr-val">{entry.data.date}</span>
              </div>
            )}
          </div>
          
          <div class="links-group">
            {entry.data.repoUrl && (
              <a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" class="link-btn">
                → VER_CODIGO_FUENTE
              </a>
            )}
            {entry.data.demoUrl && (
              <a href={entry.data.demoUrl} target="_blank" rel="noopener noreferrer" class="link-btn primary">
                → VER_DEMO_EN_VIVO
              </a>
            )}
          </div>
          {entry.data.demoUrl && entry.data.demoNote && (
            <p class="demo-note">{entry.data.demoNote}</p>
          )}
        </div>
        </div>
      </header>
      
      {entry.data.image && (
        <div class="project-screenshot">
          <img
            src={entry.data.image}
            alt={`Screenshot de ${entry.data.title}`}
            class="screenshot-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}

      <article class="content-body">
        <Content />
      </article>
      
      <div class="back-link-wrapper">
        <a href="/projects" class="back-link">← Volver a Proyectos</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-detail {
    padding: 6rem 2rem;
    min-height: 80vh;
    background-color: var(--bg-primary);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .project-header {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-mid);
  }

  /* ── Optimización de escritorio ────────────────────────────────
     Medido antes de tocar: la página eran 4,4 pantallas de scroll y
     la cabecera sola ocupaba 1.104px — más de una pantalla entera
     antes de llegar al contenido. En pantallas anchas hay espacio
     horizontal de sobra, así que se usa en vez de apilar.          */
  @media (min-width: 1100px) {
    .container {
      max-width: 1120px;
    }

    /* Cabecera en dos columnas: relato a la izquierda, ficha técnica
       y botones a la derecha. Antes iban uno debajo del otro. */
    .header-cols {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
      align-items: start;
    }

    .project-header {
      margin-bottom: 3rem;
      padding-bottom: 2.25rem;
    }

    /* El texto no se estira a 1120px: a ese ancho se pierde el
       renglón al saltar de línea. Las figuras sí usan todo. */
    .content-body :global(p),
    .content-body :global(ul),
    .content-body :global(ol) {
      max-width: 74ch;
    }

    /* Captura de la demo: sin tope se comía media pantalla.
       max-width es obligatorio junto a width:auto — sin él la imagen
       toma su ancho natural (1440px) y el overflow:hidden del
       contenedor le corta la última columna. */
    .project-screenshot img {
      max-height: 44vh;
      max-width: 100%;
      width: auto;
      height: auto;
      margin: 0 auto;
    }

    /* Tope general de altura: ninguna figura debe ocupar media
       pantalla. Medido: la de importancia llegaba a 609px de alto. */
    .content-body :global(.fig img) {
      max-height: 46vh;
      width: auto;
    }

    /* Variante con la figura del lado ancho: sirve para gráficos con
       etiquetas largas, que a media columna dejan de leerse.
       Doble clase a propósito — .split se declara más abajo y con
       igual especificidad le ganaría por orden. */
    .content-body :global(.split.split-wide) {
      grid-template-columns: 0.78fr 1.22fr;
    }

    /* Texto y figura en paralelo. Acá sí sirven dos columnas: el
       diagrama es vertical y al lado de su explicación ahorra ~550px
       de scroll sin achicar ninguno de los dos. */
    .content-body :global(.split) {
      display: grid;
      grid-template-columns: 1fr 0.85fr;
      gap: 3.5rem;
      align-items: center;
      margin: 2.5rem 0;
    }

    .content-body :global(.split > div p:last-child) {
      margin-bottom: 0;
    }

    .content-body :global(.split .fig) {
      margin: 0;
    }

    .content-body :global(.split .fig-tall img) {
      max-height: 52vh;
    }
  }

  .meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-glow);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .hash {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--hash-color);
  }

  .title {
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--ink-primary);
    margin-bottom: 0.5rem;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .role-line {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
    display: block;
  }

  .description {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--ink-primary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .meta-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-mid);
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
  }

  .attributes {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
  }

  .attr-item {
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .attr-label {
    color: var(--ink-secondary);
    width: 240px;
    flex-shrink: 0;
  }

  .attr-val {
    color: var(--ink-primary);
  }

  .attr-val.highlight {
    color: var(--accent);
    font-weight: bold;
  }

  .attr-val.ok {
    color: var(--log-ok);
    font-weight: bold;
  }

  .links-group {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .demo-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted, #8a8a8a);
    margin: 0.6rem 0 0;
    max-width: 62ch;
  }

  .link-btn {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid var(--border-strong);
    color: var(--ink-primary);
  }

  .link-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .link-btn.primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--bg-primary);
  }

  .link-btn.primary:hover {
    background-color: transparent;
    color: var(--accent);
  }

  .content-body {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--ink-primary);
    line-height: 1.8;
  }

  .content-body p {
    margin-bottom: 1.5rem;
  }

  /* :global es obligatorio — el markdown de <Content /> no recibe el
     atributo de scope de Astro, así que un selector normal no lo alcanza. */
  .content-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 6px;
    background: #fff;
  }

  /* ── Figuras ──────────────────────────────────────────────────
     El texto se lee a ~70ch; las figuras rompen ese ancho porque un
     gráfico con etiquetas necesita espacio o no se lee.            */
  .content-body :global(.fig) {
    margin: 2.75rem 0 2.25rem;
  }

  .content-body :global(.fig-wide) {
    width: 100%;
  }

  /* Diagrama vertical: si no se limita la altura ocupa más de una
     pantalla de scroll (medido: 924px) y rompe el ritmo de lectura. */
  .content-body :global(.fig-tall img) {
    max-height: 62vh;
    width: auto;
  }

  .content-body :global(figcaption) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-muted, #8a8a8a);
    margin-top: 0.85rem;
    max-width: 68ch;
  }

  /* Dos figuras cuadradas apiladas son 1.500px de scroll; una al lado
     de la otra son ~450px y además invitan a compararlas. */
  .content-body :global(.fig-pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: start;
    margin: 2.75rem 0 2.25rem;
  }

  .content-body :global(.fig-pair .fig) {
    margin: 0;
  }

  /* ── Métricas destacadas ──────────────────────────────────────
     Reemplaza una tabla que renderizaba a 157px y se leía como
     texto suelto. Cada número lleva qué significa, no solo su nombre. */
  .content-body :global(.stat-row) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: 2rem 0 2.5rem;
  }

  .content-body :global(.stat) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border-strong, rgba(255,255,255,0.14));
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
  }

  .content-body :global(.stat-num) {
    font-family: var(--font-mono);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent, #ec7357);
  }

  .content-body :global(.stat-lbl) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-primary);
  }

  .content-body :global(.stat-sub) {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-muted, #8a8a8a);
  }

  /* Tablas del markdown: sin esto colapsan al ancho del contenido. */
  .content-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.95rem;
  }

  .content-body :global(th),
  .content-body :global(td) {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border-strong, rgba(255,255,255,0.12));
  }

  .content-body :global(th) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted, #8a8a8a);
  }

  @media (max-width: 780px) {
    .content-body :global(.fig-pair),
    .content-body :global(.stat-row) {
      grid-template-columns: 1fr;
    }
    .content-body :global(.fig-tall img) {
      max-height: none;
      width: 100%;
    }
  }

  .project-screenshot {
    margin-bottom: 3rem;
    border: 1px solid var(--border-mid);
    border-radius: 4px;
    overflow: hidden;
  }

  .screenshot-img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .screenshot-img:hover {
    opacity: 1;
  }

  .back-link-wrapper {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-mid);
  }

  .back-link {
    font-family: var(--font-mono);
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .project-detail {
      padding: 4rem 1.5rem;
    }

    .attr-item {
      flex-direction: column;
      gap: 0.25rem;
    }

    .attr-label {
      width: auto;
    }

    .title {
      font-size: 2.5rem;
    }
  }
</style>
