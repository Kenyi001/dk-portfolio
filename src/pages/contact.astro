---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto | Dax Kenji" description="Ponete en contacto con Dax Kenji Tellez Duran para discutir proyectos de IA, backend y Web3.">
  <main class="contact-page">
    <div class="container">
      <header class="contact-header">
        <span class="tagline">Contacto profesional</span>
        <h1 class="page-title">Hablemos de IA en producción.</h1>
        <p class="subtitle">
          Abierto a roles de AI Backend Engineer, equipos remotos internacionales y oportunidades presenciales en Bolivia.
        </p>
      </header>

      <div class="status-msg">
        <span class="blink-dot">●</span>
        <span class="msg-text">Disponible para entrevistas técnicas y conversaciones con equipos de producto</span>
      </div>

      <div class="contact-links">
        <a href="mailto:daxkenyi001@gmail.com" class="contact-card email">
          <span class="label">EMAIL</span>
          <span class="value">daxkenyi001@gmail.com</span>
        </a>
        
        <a href="https://www.linkedin.com/in/kenyi001/?locale=es" target="_blank" rel="noopener noreferrer" class="contact-card linkedin">
          <span class="label">LINKEDIN</span>
          <span class="value">linkedin.com/in/kenyi001</span>
        </a>

        <a href="https://github.com/Kenyi001" target="_blank" rel="noopener noreferrer" class="contact-card github">
          <span class="label">GITHUB</span>
          <span class="value">github.com/Kenyi001</span>
        </a>

        <a href="/cv/CV_Dax_Kenji_AI_Backend_ES.pdf" class="contact-card cv">
          <span class="label">CV</span>
          <span class="value">Descargar CV AI Backend</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 6rem 2rem;
    background-color: var(--bg-primary);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .contact-header {
    margin-bottom: 2.5rem;
  }

  .tagline {
    font-family: var(--font-mono);
    color: var(--accent-2);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: 5rem;
    color: var(--ink-primary);
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: 0;
    margin-bottom: 1.5rem;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    max-width: 680px;
  }

  .status-msg {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--border-subtle);
    background-color: rgba(245, 241, 234, 0.045);
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    margin-bottom: 3.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .blink-dot {
    color: var(--accent);
    animation: blink-anim 1.5s infinite;
  }

  @keyframes blink-anim {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .msg-text {
    color: var(--ink-primary);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    background: rgba(245, 241, 234, 0.045);
    border: 1px solid var(--border-subtle);
    padding: 2rem;
    border-radius: 8px;
    transition: transform 0.3s ease, border-color 0.3s ease;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .contact-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow-soft);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-secondary);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .contact-card:hover .label {
    color: var(--accent);
  }

  .value {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--ink-primary);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .contact-page {
      padding: 4rem 1.5rem;
    }
    
    .status-msg {
      margin-bottom: 2.5rem;
      font-size: 0.8rem;
    }

    .page-title {
      font-size: 3rem;
    }

    .value {
      font-size: 1.1rem;
    }
  }
</style>
