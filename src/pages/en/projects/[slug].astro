---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Convert eventType enum to print labels
const typeLabels = {
  hackathon: 'HACKATHON',
  personal: 'PERSONAL',
  professional: 'PRODUCTION'
};
---

<BaseLayout title={`${entry.data.title_en || entry.data.title} | Dax Kenji`} description={entry.data.description_en || entry.data.description}>
  <div class="project-detail">
    <div class="container">
      <header class="project-header">
        <div class="meta-top">
          <span class="badge">{typeLabels[entry.data.eventType]}</span>
          <span class="hash">{entry.data.event}</span>
        </div>
        
        <h1 class="title">{entry.data.title_en || entry.data.title}</h1>
        
        <span class="role-line">ROLE → {entry.data.role_en || entry.data.role}</span>
        
        <p class="description">{entry.data.longDescription_en || entry.data.longDescription || entry.data.description_en || entry.data.description}</p>
        
        <div class="meta-info">
          <div class="stack">
            {entry.data.stack.map(tech => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
          
          <div class="attributes">
            <div class="attr-item">
              <span class="attr-label">EVENT / CONTEXT:</span>
              <span class="attr-val">{entry.data.event}</span>
            </div>
            {entry.data.award && (
              <div class="attr-item">
                <span class="attr-label">AWARD / RECOGNITION:</span>
                <span class="attr-val highlight">{entry.data.award}</span>
              </div>
            )}
            {entry.data.metrics && (
              <div class="attr-item">
                <span class="attr-label">METRICS / IMPACT:</span>
                <span class="attr-val ok">{entry.data.metrics}</span>
              </div>
            )}
            {entry.data.date && (
              <div class="attr-item">
                <span class="attr-label">DATE:</span>
                <span class="attr-val">{entry.data.date}</span>
              </div>
            )}
          </div>
          
          <div class="links-group">
            {entry.data.repoUrl && (
              <a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" class="link-btn">
                → VIEW_SOURCE_CODE
              </a>
            )}
            {entry.data.demoUrl && (
              <a href={entry.data.demoUrl} target="_blank" rel="noopener noreferrer" class="link-btn primary">
                → VIEW_LIVE_DEMO
              </a>
            )}
          </div>
          {entry.data.demoUrl && (entry.data.demoNote_en ?? entry.data.demoNote) && (
            <p class="demo-note">{entry.data.demoNote_en ?? entry.data.demoNote}</p>
          )}
        </div>
      </header>
      
      {entry.data.image && (
        <div class="project-screenshot">
          <img
            src={entry.data.image}
            alt={`Screenshot of ${entry.data.title_en || entry.data.title}`}
            class="screenshot-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}

      <article class="content-body">
        <Content />
      </article>

      <div class="back-link-wrapper">
        <a href="/en/projects" class="back-link">← Back to Projects</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-detail {
    padding: 6rem 2rem;
    min-height: 80vh;
    background-color: var(--bg-primary);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .project-header {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-mid);
  }

  .meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-glow);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .hash {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--hash-color);
  }

  .title {
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--ink-primary);
    margin-bottom: 0.5rem;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .role-line {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
    display: block;
  }

  .description {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--ink-primary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .meta-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-mid);
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
  }

  .attributes {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
  }

  .attr-item {
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .attr-label {
    color: var(--ink-secondary);
    width: 240px;
    flex-shrink: 0;
  }

  .attr-val {
    color: var(--ink-primary);
  }

  .attr-val.highlight {
    color: var(--accent);
    font-weight: bold;
  }

  .attr-val.ok {
    color: var(--log-ok);
    font-weight: bold;
  }

  .links-group {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .demo-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted, #8a8a8a);
    margin: 0.6rem 0 0;
    max-width: 62ch;
  }

  .link-btn {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid var(--border-strong);
    color: var(--ink-primary);
  }

  .link-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .link-btn.primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--bg-primary);
  }

  .link-btn.primary:hover {
    background-color: transparent;
    color: var(--accent);
  }

  .project-screenshot {
    margin-bottom: 3rem;
    border: 1px solid var(--border-mid);
    border-radius: 4px;
    overflow: hidden;
  }

  .screenshot-img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .screenshot-img:hover {
    opacity: 1;
  }

  .content-body {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--ink-primary);
    line-height: 1.8;
  }

  .content-body p {
    margin-bottom: 1.5rem;
  }

  /* :global is required — markdown from <Content /> does not get Astro's
     scope attribute, so a plain selector never matches it. */
  .content-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 6px;
    background: #fff;
  }

  /* Figures break the reading width: a chart with axis labels needs
     room or it becomes unreadable. */
  .content-body :global(.fig) {
    margin: 2.75rem 0 2.25rem;
  }

  .content-body :global(.fig-wide) {
    width: 100%;
  }

  /* Tall diagram: uncapped it runs past a full screen of scroll
     (measured: 924px) and breaks the reading rhythm. */
  .content-body :global(.fig-tall img) {
    max-height: 62vh;
    width: auto;
  }

  .content-body :global(figcaption) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-muted, #8a8a8a);
    margin-top: 0.85rem;
    max-width: 68ch;
  }

  /* Two square figures stacked are 1,500px of scroll; side by side
     they are ~450px and invite comparison. */
  .content-body :global(.fig-pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: start;
    margin: 2.75rem 0 2.25rem;
  }

  .content-body :global(.fig-pair .fig) {
    margin: 0;
  }

  /* Headline metrics — replaces a table that collapsed to 157px
     and read like loose text. */
  .content-body :global(.stat-row) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: 2rem 0 2.5rem;
  }

  .content-body :global(.stat) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border-strong, rgba(255,255,255,0.14));
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
  }

  .content-body :global(.stat-num) {
    font-family: var(--font-mono);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent, #ec7357);
  }

  .content-body :global(.stat-lbl) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-primary);
  }

  .content-body :global(.stat-sub) {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-muted, #8a8a8a);
  }

  /* Markdown tables collapse to content width without this. */
  .content-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.95rem;
  }

  .content-body :global(th),
  .content-body :global(td) {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border-strong, rgba(255,255,255,0.12));
  }

  .content-body :global(th) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted, #8a8a8a);
  }

  @media (max-width: 780px) {
    .content-body :global(.fig-pair),
    .content-body :global(.stat-row) {
      grid-template-columns: 1fr;
    }
    .content-body :global(.fig-tall img) {
      max-height: none;
      width: 100%;
    }
  }

  .back-link-wrapper {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-mid);
  }

  .back-link {
    font-family: var(--font-mono);
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .project-detail {
      padding: 4rem 1.5rem;
    }

    .attr-item {
      flex-direction: column;
      gap: 0.25rem;
    }

    .attr-label {
      width: auto;
    }

    .title {
      font-size: 2.5rem;
    }
  }
</style>
