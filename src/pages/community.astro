---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityNodes from '../components/CommunityNodes.astro';
import LearningPath from '../components/LearningPath.astro';
---

<BaseLayout title="Community | Dax Kenji" description="La participación activa de Dax Kenji en las comunidades locales y globales de desarrollo de software, Web3 e Inteligencia Artificial.">
  <div class="community-page">
    <div class="container">
      <header class="community-header">
        <h1 class="page-title">Comunidad</h1>
        <p class="subtitle">
          Eventos, charlas y meetups en Bolivia. IA y Web3 desde adentro, no desde el manual.
        </p>
      </header>
    </div>
    
    <CommunityNodes />
    <LearningPath />
  </div>
</BaseLayout>

<style>
  .community-page {
    padding-top: 4rem;
    background-color: var(--bg-primary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .community-header {
    margin-bottom: 4rem;
  }

  .page-title {
    font-family: var(--font-mono);
    font-size: 3rem;
    color: var(--hash-color);
    margin-bottom: 1.5rem;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    max-width: 800px;
  }

  @media (max-width: 768px) {
    .community-page {
      padding-top: 2rem;
    }
    
    .community-header {
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: 2.2rem;
    }
  }
</style>
