---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import EducationSection from '../components/EducationSection.astro';
import AchievementsSection from '../components/AchievementsSection.astro';
import CommunityNodes from '../components/CommunityNodes.astro';
---

<BaseLayout title="Sobre mí | Dax Kenji" description="Ingeniero de Sistemas UTEPSA (defensa 13 ago 2026). Desarrollador IA en CoolFix Ethical Service. Santa Cruz, Bolivia. Open to roles.">
  <div class="about-page">
    <div class="container">
      <header class="about-header">
        <span class="tagline">Sobre mí</span>
        <h1 class="page-title">AI Backend Engineer con base en producción real.</h1>
        <div class="bio-extended">
          <p>
            Ingeniero de Sistemas titulado (UTEPSA, defensa aprobada 13 ago 2026). En Santa Cruz, Bolivia. Desarrollador IA / Integraciones IA en <strong>CoolFix Ethical Service</strong> (automatización WhatsApp, n8n, WABA). Abierto a roles remotos y colaboraciones (segundo frente).
          </p>
          <p>
            Antes: sistemas RAG, OCR y Webhooks en banca (Hola / BCP, ago 2025 – jun 2026). Comunidad: GDG Santa Cruz, YAIS Lab (AI Research Tour), staff Cursor Buildathon Bolivia. Ranking #89 mundial DEV3PACK.
          </p>
        </div>
      </header>
    </div>
    
    <SkillsSection />
    <ExperienceSection />
    <EducationSection />
    <AchievementsSection />
    <CommunityNodes />
    
    <div class="contact-cta">
      <div class="container text-center">
        <h2>¿Buscás un perfil AI Backend?</h2>
        <p>Estoy abierto a equipos remotos internacionales y oportunidades presenciales seleccionadas en Bolivia.</p>
        <a href="/contact" class="cta-link">Contactar</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: 4rem;
    background-color: var(--bg-primary);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .text-center {
    text-align: center;
  }

  .about-header {
    margin-bottom: 6rem;
  }

  .tagline {
    font-family: var(--font-mono);
    color: var(--accent-2);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 1rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: 4.6rem;
    color: var(--ink-primary);
    line-height: 1;
    margin-bottom: 3rem;
  }

  .bio-extended p {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--ink-primary);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .contact-cta {
    padding: 6rem 2rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
  }

  .contact-cta h2 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--ink-primary);
    margin-bottom: 1rem;
  }

  .contact-cta p {
    font-family: var(--font-body);
    color: var(--ink-secondary);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
  }

  .cta-link {
    display: inline-block;
    font-family: var(--font-mono);
    color: var(--bg-primary);
    background-color: var(--accent);
    padding: 0.8rem 1.6rem;
    border-radius: 6px;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid var(--accent);
  }

  .cta-link:hover {
    background-color: transparent;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .about-page {
      padding-top: 2rem;
    }
    
    .about-header {
      margin-bottom: 3rem;
    }
    
    .bio-extended p {
      font-size: 1.1rem;
    }

    .page-title {
      font-size: 2.9rem;
    }

    .contact-cta {
      padding: 4rem 1.5rem;
    }
  }
</style>
