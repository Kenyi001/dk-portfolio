---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { getLangFromUrl, useTranslations } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title?: string;
  description?: string;
}
const {
  title = t('meta.title'),
  description = t('meta.description')
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- OpenGraph Metadata -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://daxkenyi.is-a.dev" />
  <meta property="og:image" content="https://daxkenyi.is-a.dev/og.png" />

  <!-- Twitter Card Metadata -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@daxkenyi001" />
  <meta name="twitter:image" content="https://daxkenyi.is-a.dev/og.png" />

  <!-- Canonical -->
  <link rel="canonical" href="https://daxkenyi.is-a.dev" />

  <!-- hreflang: versiones del sitio en cada idioma -->
  <link rel="alternate" hreflang="es" href={`https://daxkenyi.is-a.dev${lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname}`} />
  <link rel="alternate" hreflang="en" href={`https://daxkenyi.is-a.dev/en${lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname}`} />
  <link rel="alternate" hreflang="x-default" href={`https://daxkenyi.is-a.dev${lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname}`} />

  <!-- AI Discoverability -->
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="alternate" type="text/plain" href="https://daxkenyi.is-a.dev/llms.txt" title="LLMs.txt" />

  <!-- JSON-LD: datos estructurados para Google y agentes de IA -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://daxkenyi.is-a.dev/#person",
        "name": "Dax Kenji Tellez Duran",
        "url": "https://daxkenyi.is-a.dev",
        "jobTitle": "Backend Engineer & AI Developer",
        "description": "Backend engineer especializado en sistemas de IA: RAG, LLMs, Voice AI. Santa Cruz, Bolivia.",
        "email": "daxkenyi001@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Santa Cruz",
          "addressCountry": "BO"
        },
        "sameAs": [
          "https://linkedin.com/in/kenyi001",
          "https://github.com/Kenyi001"
        ],
        "knowsAbout": [
          "Node.js", "TypeScript", "Python", "C# .NET",
          "RAG Systems", "LLM Optimization", "ElevenLabs",
          "Docker", "GCP", "Azure", "AWS"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://daxkenyi.is-a.dev/#website",
        "name": "Dax Kenji — Portfolio",
        "url": "https://daxkenyi.is-a.dev",
        "description": "Portfolio de Dax Kenji Tellez Duran, Backend Engineer & AI Developer.",
        "author": { "@id": "https://daxkenyi.is-a.dev/#person" }
      }
    ]
  }
  </script>
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=4" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=4" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=4" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
  
  <!-- Google Fonts Preconnect & Stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500&display=swap" />
  <!-- global.css importado vía frontmatter para build correcto en producción -->
</head>
<body>
  <div id="scroll-bar" aria-hidden="true"></div>
  <canvas id="bg-grid" aria-hidden="true"></canvas>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- Vercel Analytics: cuenta visitas, páginas vistas, países, dispositivos -->
  <Analytics />
  <!-- Vercel Speed Insights: mide cuán rápido carga tu sitio para usuarios reales -->
  <SpeedInsights />

  <script>
    /* ─── console easter egg ─── */
    console.log(
      '%c  ██████╗ ██╗  ██╗\n  ██╔══██╗██║ ██╔╝\n  ██║  ██║█████╔╝ \n  ██║  ██║██╔═██╗ \n  ██████╔╝██║  ██╗\n  ╚═════╝ ╚═╝  ╚═╝',
      'color:#D4513A;font-family:monospace;'
    );
    console.log('%c> inspeccionando el código. hola.\n→ daxkenyi001@gmail.com', 'color:#4B8A6E;font-family:monospace;');

    /* ─── scroll progress bar ─── */
    (function () {
      const bar = document.getElementById('scroll-bar');
      if (!bar) return;
      function update() {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }
      window.addEventListener('scroll', update, { passive: true });
      update();
    })();

    /* ─── fondo reactivo al mouse ─── */
    (function () {
      if (window.matchMedia('(hover: none)').matches) return; // skip touch

      const canvas = /** @type {HTMLCanvasElement} */ (document.getElementById('bg-grid'));
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      const SPACING = 40;   // distancia entre puntos
      const REACH   = 155;  // radio de influencia del cursor
      const LERP    = 0.09; // suavizado del seguimiento

      let tw = -9999, th = -9999; // posición target del mouse
      let mx = -9999, my = -9999; // posición suavizada
      let raf = null;

      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
      }

      function draw() {
        // Lerp hacia el mouse real
        mx += (tw - mx) * LERP;
        my += (th - my) * LERP;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Glow suave radial centrado en el cursor
        const g = ctx.createRadialGradient(mx, my, 0, mx, my, 480);
        g.addColorStop(0,   'rgba(212,81,58,0.055)');
        g.addColorStop(0.5, 'rgba(212,81,58,0.018)');
        g.addColorStop(1,   'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Grid de puntos
        const cols = Math.ceil(canvas.width  / SPACING) + 1;
        const rows = Math.ceil(canvas.height / SPACING) + 1;

        for (let i = 0; i < cols; i++) {
          for (let j = 0; j < rows; j++) {
            const x = i * SPACING;
            const y = j * SPACING;
            const d = Math.hypot(x - mx, y - my);
            const t = Math.max(0, 1 - d / REACH);

            ctx.beginPath();
            ctx.arc(x, y, t > 0 ? 1 + t * 2 : 1, 0, Math.PI * 2);
            ctx.fillStyle = t > 0.04
              ? `rgba(212,81,58,${+(0.07 + t * 0.38).toFixed(2)})`
              : 'rgba(232,224,212,0.05)';
            ctx.fill();
          }
        }

        raf = requestAnimationFrame(draw);
      }

      document.addEventListener('mousemove', e => { tw = e.clientX; th = e.clientY; });
      window.addEventListener('resize', resize, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { cancelAnimationFrame(raf); raf = null; }
        else if (!raf) draw();
      });

      resize();
      draw();
    })();
  </script>
</body>
</html>
