---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { getLangFromUrl, useTranslations } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title?: string;
  description?: string;
}
const {
  title = t('meta.title'),
  description = t('meta.description')
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- OpenGraph Metadata -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://daxkenyi.is-a.dev" />
  <meta property="og:image" content="https://daxkenyi.is-a.dev/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card Metadata -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@daxkenyi001" />
  <meta name="twitter:image" content="https://daxkenyi.is-a.dev/og.png" />

  <!-- Canonical — apunta a la URL exacta de cada página -->
  <link rel="canonical" href={`https://daxkenyi.is-a.dev${Astro.url.pathname}`} />

  <!-- hreflang: versiones del sitio en cada idioma -->
  <link rel="alternate" hreflang="es" href={`https://daxkenyi.is-a.dev${lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname}`} />
  <link rel="alternate" hreflang="en" href={`https://daxkenyi.is-a.dev/en${lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname}`} />
  <link rel="alternate" hreflang="x-default" href={`https://daxkenyi.is-a.dev${lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname}`} />

  <!-- AI Discoverability -->
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="alternate" type="text/plain" href="https://daxkenyi.is-a.dev/llms.txt" title="LLMs.txt" />

  <!-- JSON-LD: datos estructurados para Google y agentes de IA -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://daxkenyi.is-a.dev/#person",
        "name": "Dax Kenji Tellez Duran",
        "url": "https://daxkenyi.is-a.dev",
        "jobTitle": "Backend Engineer & AI Developer",
        "description": "Backend engineer especializado en sistemas de IA: RAG, LLMs, Voice AI. Santa Cruz, Bolivia.",
        "email": "daxkenyi001@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Santa Cruz",
          "addressCountry": "BO"
        },
        "sameAs": [
          "https://linkedin.com/in/kenyi001",
          "https://github.com/Kenyi001"
        ],
        "knowsAbout": [
          "Node.js", "TypeScript", "Python", "C# .NET",
          "RAG Systems", "LLM Optimization", "ElevenLabs",
          "Docker", "GCP", "Azure", "AWS"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://daxkenyi.is-a.dev/#website",
        "name": "Dax Kenji — Portfolio",
        "url": "https://daxkenyi.is-a.dev",
        "description": "Portfolio de Dax Kenji Tellez Duran, Backend Engineer & AI Developer.",
        "author": { "@id": "https://daxkenyi.is-a.dev/#person" }
      }
    ]
  }
  </script>
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=5" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=5" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=5" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
  
  <!-- Google Fonts Preconnect & Stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500&family=Archivo:wght@400;500;600&display=swap" />
  <!-- global.css importado vía frontmatter para build correcto en producción -->
</head>
<body>
  <div id="scroll-bar" aria-hidden="true"></div>
  <canvas id="bg-grid" aria-hidden="true"></canvas>
  <div class="ambient-auras" aria-hidden="true">
    <span class="aura aura-warm"></span>
    <span class="aura aura-cool"></span>
  </div>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- Vercel Analytics: cuenta visitas, páginas vistas, países, dispositivos -->
  <Analytics />
  <!-- Vercel Speed Insights: mide cuán rápido carga tu sitio para usuarios reales -->
  <SpeedInsights />

  <script>
    /* ─── console easter egg ─── */
    console.log(
      '%c  ██████╗ ██╗  ██╗\n  ██╔══██╗██║ ██╔╝\n  ██║  ██║█████╔╝ \n  ██║  ██║██╔═██╗ \n  ██████╔╝██║  ██╗\n  ╚═════╝ ╚═╝  ╚═╝',
      'color:#D4513A;font-family:monospace;'
    );
    console.log('%c> inspeccionando el código. hola.\n→ daxkenyi001@gmail.com', 'color:#4B8A6E;font-family:monospace;');

    /* ─── scroll reveal ─── */
    (function () {
      const els = document.querySelectorAll('[data-reveal]');
      if (!els.length) return;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.07, rootMargin: '0px 0px -40px 0px' }
      );
      els.forEach(el => io.observe(el));
    })();

    /* ─── scroll progress bar ─── */
    (function () {
      const bar = document.getElementById('scroll-bar');
      if (!bar) return;
      function update() {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }
      window.addEventListener('scroll', update, { passive: true });
      update();
    })();

    /* ─── fondo reactivo al mouse — dual glow + color transition ─── */
    (function () {
      if (window.matchMedia('(hover: none)').matches) return;

      const canvas = /** @type {HTMLCanvasElement} */ (document.getElementById('bg-grid'));
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      const SPACING = 38;   // densidad del grid
      const REACH   = 200;  // radio de influencia del cursor (ampliado)
      const LERP    = 0.07; // seguimiento suave/natural

      // Colores del sistema de diseño
      const ACC = [212, 81,  58 ];  // --accent rojo
      const HSH = [75,  138, 110];  // --hash-color verde

      let tw = -9999, th = -9999;
      let mx = -9999, my = -9999;
      let raf = null;

      function lerp(a, b, t) { return a + (b - a) * t; }

      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
      }

      function draw() {
        mx += (tw - mx) * LERP;
        my += (th - my) * LERP;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Capa 1: halo verde grande y difuso — da profundidad de ambiente
        const g1 = ctx.createRadialGradient(mx, my, 0, mx, my, 620);
        g1.addColorStop(0,   `rgba(${HSH},0.04)`);
        g1.addColorStop(0.45,`rgba(${HSH},0.015)`);
        g1.addColorStop(1,   'rgba(0,0,0,0)');
        ctx.fillStyle = g1;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Capa 2: foco rojo-acento concentrado en el cursor
        const g2 = ctx.createRadialGradient(mx, my, 0, mx, my, 280);
        g2.addColorStop(0,   `rgba(${ACC},0.09)`);
        g2.addColorStop(0.55,`rgba(${ACC},0.025)`);
        g2.addColorStop(1,   'rgba(0,0,0,0)');
        ctx.fillStyle = g2;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Grid de puntos con transición de color por distancia
        const cols = Math.ceil(canvas.width  / SPACING) + 1;
        const rows = Math.ceil(canvas.height / SPACING) + 1;

        for (let i = 0; i < cols; i++) {
          for (let j = 0; j < rows; j++) {
            const x = i * SPACING;
            const y = j * SPACING;
            const d = Math.hypot(x - mx, y - my);
            const t = Math.max(0, 1 - d / REACH);

            let r, g, b, a, radius;

            if (t > 0.55) {
              // Muy cerca — acento rojo puro
              const p = (t - 0.55) / 0.45;
              r = lerp(HSH[0], ACC[0], p);
              g = lerp(HSH[1], ACC[1], p);
              b = lerp(HSH[2], ACC[2], p);
              a = 0.15 + t * 0.42;
              radius = 1 + t * 2.5;
            } else if (t > 0.05) {
              // Distancia media — verde hash
              const p = (t - 0.05) / 0.5;
              r = HSH[0]; g = HSH[1]; b = HSH[2];
              a = 0.07 + p * 0.15;
              radius = 1 + t * 1.5;
            } else {
              // Lejos — dots base visibles en todo el fondo
              r = 232; g = 224; b = 212;
              a = 0.10;  // opacidad aumentada para que se vea en secciones semi-transparentes
              radius = 1;
            }

            const cr = Math.round(r), cg = Math.round(g), cb = Math.round(b);
            const ca = +a.toFixed(2);

            if (t > 0.05) {
              // Dots activos — glow difuminado con shadowBlur
              ctx.save();
              ctx.shadowColor = `rgba(${cr},${cg},${cb},${+(a * 0.7).toFixed(2)})`;
              ctx.shadowBlur   = 4 + t * 14; // más cerca = más difuso/brillante
              ctx.beginPath();
              ctx.arc(x, y, Math.max(0.5, radius * 0.55), 0, Math.PI * 2);
              ctx.fillStyle = `rgba(${cr},${cg},${cb},${+(a * 0.85).toFixed(2)})`;
              ctx.fill();
              ctx.restore();
            } else {
              // Dots base — puntitos simples sin blur (performance)
              ctx.beginPath();
              ctx.arc(x, y, 0.8, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(${cr},${cg},${cb},${ca})`;
              ctx.fill();
            }
          }
        }

        raf = requestAnimationFrame(draw);
      }

      document.addEventListener('mousemove', e => { tw = e.clientX; th = e.clientY; });
      window.addEventListener('resize', resize, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { cancelAnimationFrame(raf); raf = null; }
        else if (!raf) draw();
      });

      resize();
      draw();
    })();
  </script>
</body>
</html>
